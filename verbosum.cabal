cabal-version: 3.0
name: verbosum
version: 0.1.0.0
-- synopsis:
-- description:
license: BSD-3-Clause
license-file: LICENSE
author: Armando Ramirez
maintainer: armando.m.ramirez@gmail.com
-- copyright:
category: AI
build-type: Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:
common warnings
  ghc-options: -Wall

common exts
  default-extensions:
    AllowAmbiguousTypes
    BangPatterns
    BinaryLiterals
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    EmptyCase
    EmptyDataDecls
    EmptyDataDeriving
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    ImplicitParams
    ImportQualifiedPost
    ImpredicativeTypes
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    NegativeLiterals
    OverloadedLabels
    OverloadedRecordDot
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    StrictData
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    UndecidableInstances
    ViewPatterns

library
  import: warnings, exts
  -- cabal-gild: discover src
  exposed-modules:
    Verbosum.CLI
    Verbosum.OmegaLOL

  -- other-modules:
  -- other-extensions:
  build-depends:
    base,
    bytestring,
    claude,
    mtl,
    optparse-applicative,
    text,

  hs-source-dirs: src
  default-language: GHC2024

executable verbosum
  import: warnings
  main-is: Main.hs
  -- other-modules:
  -- other-extensions:
  build-depends:
    base ^>=4.20.2.0,
    verbosum,

  hs-source-dirs: exe
  default-language: GHC2024

test-suite verbosum-test
  import: warnings
  default-language: GHC2024
  -- other-modules:
  -- other-extensions:
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base ^>=4.20.2.0,
    verbosum,
